{
  "name": "rotacao",
  "version": "1.0.0",
  "description": "Loja de discos e salas de ensaio em Lisboa, com caixotes para folhear e gira-discos 3D",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "catalogo": "node scripts/catalogo.js",
    "vendor": "esbuild scripts/three.js --bundle --minify --format=esm --legal-comments=none --outfile=public/vendor/three.min.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
