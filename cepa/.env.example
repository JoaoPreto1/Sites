PORT=3000
NODE_ENV=development

# Endereço público do site (usado no canonical, Open Graph e sitemap)
SITE_URL=http://localhost:3000

# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troca-isto-por-um-segredo-comprido
JWT_REFRESH_SECRET=troca-isto-por-outro-segredo-comprido
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7

# Só é preciso se o frontend estiver noutro domínio (separar por vírgulas)
CORS_ORIGIN=
