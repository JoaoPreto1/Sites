PORT=3009
NODE_ENV=development

# Endereço público do site (canonical, Open Graph e sitemap). Em produção tem de ser https://
SITE_URL=http://localhost:3009

# Gerar cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troca-isto
JWT_REFRESH_SECRET=troca-isto-tambem
# Segredo diferente para a gestão: um token de utilizador nunca serve na área de gestão
STAFF_JWT_SECRET=e-isto-tambem

# Conta do dono da plataforma, criada no primeiro arranque se ainda não existir
OWNER_NAME=Dono da plataforma
OWNER_EMAIL=dono@exemplo.pt
OWNER_PASSWORD=uma-palavra-passe-longa-e-unica

# Prestador de pagamentos. "demo" só simula e nunca movimenta dinheiro.
# Um prestador real só pode ser ligado depois de a lista "antes do lançamento" estar completa.
PAYMENT_PROVIDER=demo

# Pasta privada para os documentos enviados (fora da pasta pública)
STORAGE_DIR=./storage
