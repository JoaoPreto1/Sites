{
  "name": "arriba",
  "version": "1.0.0",
  "description": "Hotel de 14 quartos em Sagres (fictício): as chaves livres estão penduradas num quadro 3D, reservas, área do hóspede e painel da receção",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "vendor": "esbuild scripts/three.js --bundle --minify --format=esm --legal-comments=none --outfile=public/vendor/three.min.js",
    "fotos": "node scripts/fotos.mjs",
    "quadro": "node scripts/quadro.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "^0.187.0"
  }
}
